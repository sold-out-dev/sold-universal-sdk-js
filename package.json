{
  "name": "sold-universal-sdk-js",
  "version": "1.0.1",
  "description": "TypeScript/JavaScript SDK for Akamai Bot Manager. Generate sensor data, pixel, sbsd and cookies without headless browsers.",
  "type": "module",
  "main": "index.js",
  "homepage": "https://sold-out.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sold-out-dev/sold-universal-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/sold-out-dev/sold-universal-sdk-js/issues"
  },
  "exports": {
    ".": "./index.js",
    "./akamai": "./akamai/index.js",
    "./akamai/*": "./akamai/*.js",
    "./shared": "./shared/index.js",
    "./shared/*": "./shared/*.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "akamai",
    "bot-protection",
    "bypass",
    "anti-bot",
    "sensor-data",
    "web-scraping",
    "automation"
  ],
  "author": "soldout",
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.4.4",
    "undici": "^7.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
